{
  "name": "totonoe-log",
  "displayName": "Totonoe Log",
  "description": "Normalize, merge, filter, collapse, and compare messy logs.",
  "version": "0.2.0",
  "publisher": "upu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/upu/Totonoe-Log.git"
  },
  "homepage": "https://github.com/upu/Totonoe-Log#readme",
  "bugs": {
    "url": "https://github.com/upu/Totonoe-Log/issues"
  },
  "galleryBanner": {
    "color": "#1e2330",
    "theme": "dark"
  },
  "keywords": [
    "log",
    "logs",
    "logging",
    "normalize",
    "merge",
    "diff",
    "troubleshooting"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "totonoeLog.showMergedView",
        "title": "Totonoe Log: Show Merged View"
      },
      {
        "command": "totonoeLog.showNormalizedView",
        "title": "Totonoe Log: Show Normalized View"
      },
      {
        "command": "totonoeLog.showNormalizedViewFilteredBySeverity",
        "title": "Totonoe Log: Show Normalized View Filtered by Severity"
      },
      {
        "command": "totonoeLog.showNormalizedViewFilteredByDateRange",
        "title": "Totonoe Log: Show Normalized View Filtered by Date Range"
      },
      {
        "command": "totonoeLog.showNormalizedViewFilteredByDateRangeAndSeverity",
        "title": "Totonoe Log: Show Normalized View Filtered by Date Range and Severity"
      },
      {
        "command": "totonoeLog.showNormalizedViewFilteredByIgnorePattern",
        "title": "Totonoe Log: Show Normalized View Filtered by Ignore Pattern"
      },
      {
        "command": "totonoeLog.compareLogs",
        "title": "Totonoe Log: Compare Logs"
      },
      {
        "command": "totonoeLog.copyMaskedText",
        "title": "Totonoe Log: Copy Masked Text"
      },
      {
        "command": "totonoeLog.showCollapsedView",
        "title": "Totonoe Log: Show Collapsed View"
      }
    ],
    "configuration": {
      "title": "Totonoe Log",
      "properties": {
        "totonoeLog.copyMasked.maskTimestamp": {
          "type": "boolean",
          "default": true,
          "description": "Totonoe Log: Copy Masked Text 実行時にタイムスタンプをマスクする。"
        },
        "totonoeLog.copyMasked.maskHost": {
          "type": "boolean",
          "default": true,
          "description": "Totonoe Log: Copy Masked Text 実行時にIPv4アドレスと、syslog形式として認識できた行のホスト名トークンをマスクする（任意の形式のホスト名全般ではない）。"
        },
        "totonoeLog.collapse.threshold": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "description": "Totonoe Log: Show Collapsed View で、何回以上連続で繰り返されたら1行に折りたたむかのしきい値。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/esbuild.js --production",
    "watch": "node scripts/esbuild.js --watch",
    "compile": "tsc -p ./",
    "check-types": "tsc --noEmit",
    "test": "vscode-test",
    "check:package": "node scripts/check-package-contents.js",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/totonoe-log.vsix",
    "install:vsix": "code --install-extension dist/totonoe-log.vsix --force",
    "package:install": "npm run package && npm run install:vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
