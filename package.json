{
  "name": "totonoe-log",
  "displayName": "Totonoe Log",
  "description": "Normalize, merge, filter, collapse, and compare messy logs.",
  "version": "0.8.1",
  "publisher": "upu",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/upu/Totonoe-Log.git"
  },
  "homepage": "https://github.com/upu/Totonoe-Log#readme",
  "bugs": {
    "url": "https://github.com/upu/Totonoe-Log/issues"
  },
  "galleryBanner": {
    "color": "#1e2330",
    "theme": "dark"
  },
  "keywords": [
    "log",
    "logs",
    "logging",
    "normalize",
    "merge",
    "diff",
    "troubleshooting"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "totonoeLog.mergeSelectedFiles",
        "title": "Totonoe Log: Merge Selected Files"
      },
      {
        "command": "totonoeLog.mergeSelectedFilesFiltered",
        "title": "Totonoe Log: Merge Selected Files Filtered"
      },
      {
        "command": "totonoeLog.showNormalizedView",
        "title": "Totonoe Log: Show Normalized View"
      },
      {
        "command": "totonoeLog.showNormalizedViewFiltered",
        "title": "Totonoe Log: Show Normalized View Filtered"
      },
      {
        "command": "totonoeLog.compareLogs",
        "title": "Totonoe Log: Compare Logs"
      },
      {
        "command": "totonoeLog.copyMaskedText",
        "title": "Totonoe Log: Copy Masked Text"
      },
      {
        "command": "totonoeLog.goToSourceLine",
        "title": "Totonoe Log: Go to Source Line"
      },
      {
        "command": "totonoeLog.showInteractiveView",
        "title": "Totonoe Log: Show Interactive View"
      },
      {
        "command": "totonoeLog.goToSourceLineFromInteractiveView",
        "title": "Totonoe Log: Go to Source Line"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "totonoeLog.goToSourceLineFromInteractiveView",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "totonoeLog.goToSourceLineFromInteractiveView",
          "when": "webviewSection == totonoeLogInteractiveLine",
          "group": "totonoeLog@1"
        }
      ],
      "explorer/context": [
        {
          "command": "totonoeLog.mergeSelectedFiles",
          "when": "listMultiSelection",
          "group": "totonoeLog@1"
        },
        {
          "command": "totonoeLog.mergeSelectedFilesFiltered",
          "when": "listMultiSelection",
          "group": "totonoeLog@2"
        },
        {
          "command": "totonoeLog.showInteractiveView",
          "when": "!explorerResourceIsFolder",
          "group": "totonoeLog@3"
        }
      ],
      "editor/context": [
        {
          "command": "totonoeLog.goToSourceLine",
          "when": "resourceScheme == totonoe-log-normalized || resourceScheme == totonoe-log-merged",
          "group": "totonoeLog@1"
        }
      ]
    },
    "configuration": {
      "title": "Totonoe Log",
      "properties": {
        "totonoeLog.copyMasked.maskTimestamp": {
          "type": "boolean",
          "default": true,
          "description": "Totonoe Log: Copy Masked Text 実行時にタイムスタンプをマスクする。"
        },
        "totonoeLog.copyMasked.maskHost": {
          "type": "boolean",
          "default": true,
          "description": "Totonoe Log: Copy Masked Text 実行時にIPv4/IPv6アドレスと、syslog形式として認識できた行のホスト名トークンをマスクする（任意の形式のホスト名全般ではない）。"
        },
        "totonoeLog.copyMasked.maskProcessId": {
          "type": "boolean",
          "default": false,
          "description": "Totonoe Log: Copy Masked Text 実行時にプロセスIDをマスクする（syslog形式の sshd[1234]: と、pid=1234 のようにpidと明記された表記）。Interactive View のマスクパネルの初期値にもなる。"
        },
        "totonoeLog.collapse.threshold": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "description": "Totonoe Log: Show Interactive View の「繰り返しを折りたたむ」で、何回以上連続で繰り返されたら1行に折りたたむかのしきい値。"
        },
        "totonoeLog.gap.thresholdSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Totonoe Log: Show Normalized View とその絞り込み系コマンドで、連続するエントリのタイムスタンプ差がこの秒数以上のときに「XX秒の空白」の区切り行を挿入する。0 を指定すると無効化する。"
        },
        "totonoeLog.interactiveView.maxDisplayLines": {
          "type": "number",
          "default": 20000,
          "minimum": 0,
          "description": "Totonoe Log: Show Interactive View が一度に描画する行数の上限。超えた場合は先頭のみを表示し、警告と全体を開く手段（Export as Virtual Document）を案内する。0 を指定すると無効化する。"
        },
        "totonoeLog.timezone.display": {
          "type": "string",
          "default": "UTC",
          "description": "各ビューでタイムスタンプを表示するタイムゾーン。\"UTC\"、\"local\"（このマシンのローカルタイムゾーン）、または \"+09:00\" のような UTC オフセットを指定する。UTC 以外はオフセット付き（例: 2024-01-02T12:04:05.000+09:00）で表示される。"
        },
        "totonoeLog.timezone.sourceOffset": {
          "type": "string",
          "default": "UTC",
          "description": "タイムゾーン表記を持たないタイムスタンプ（例: 2024-01-02 03:04:05）を解釈するときに仮定する UTC オフセット（例: \"+09:00\"）。明示的なオフセットや Z を持つタイムスタンプ、エポック形式には影響しない。"
        },
        "totonoeLog.timezone.fileOffsets": {
          "type": "array",
          "default": [],
          "markdownDescription": "ファイル名パターンごとに `totonoeLog.timezone.sourceOffset` を上書きする。マージ時にサーバごとのタイムゾーン違いを補正する用途。上から順に評価し、最初にマッチした規則を使う。",
          "items": {
            "type": "object",
            "required": [
              "filePattern",
              "offset"
            ],
            "properties": {
              "filePattern": {
                "type": "string",
                "description": "ファイル名（パスを除いたベース名）にマッチさせる正規表現。"
              },
              "offset": {
                "type": "string",
                "description": "適用する UTC オフセット（例: \"+09:00\"）。"
              }
            }
          }
        },
        "totonoeLog.clockSkew.fileOffsets": {
          "type": "array",
          "default": [],
          "markdownDescription": "時計がずれているホストのログの時刻を、ファイル名パターンごとに±N秒補正する。タイムゾーン表記の有無にかかわらず全タイムスタンプに適用され、マージ・正規化ビューは補正後の時刻を使う。上から順に評価し、最初にマッチした規則を使う。",
          "items": {
            "type": "object",
            "required": [
              "filePattern",
              "offsetSeconds"
            ],
            "properties": {
              "filePattern": {
                "type": "string",
                "description": "ファイル名（パスを除いたベース名）にマッチさせる正規表現。"
              },
              "offsetSeconds": {
                "type": "number",
                "description": "適用する補正量（秒）。時計が進んでいるホストには負の値（例: -40）で戻す。"
              }
            }
          }
        },
        "totonoeLog.timestampFormats": {
          "type": "array",
          "default": [],
          "markdownDescription": "組み込みで認識されないタイムスタンプ形式を、正規表現＋名前付きキャプチャグループで追加する。組み込み形式より先に試行される。カレンダー形式はグループ `y` `mo` `d` `h` `mi` `s`（任意で `ms` `tzs` `tzh` `tzm`）、エポック形式はグループ `epochMs` または `epochSec`（任意で `ms`）を含めること。詳細は README の「Custom timestamp formats」参照。",
          "items": {
            "type": "object",
            "required": [
              "pattern"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "この形式の表示名。省略時は custom-<連番>。"
              },
              "pattern": {
                "type": "string",
                "description": "行頭のタイムスタンプにマッチする正規表現（自動的に行頭へアンカーされる）。名前付きキャプチャグループでパース方法を指定する。"
              }
            }
          }
        },
        "totonoeLog.highlightRules": {
          "type": "array",
          "default": [],
          "markdownDescription": "Interactive View で目立たせたいキーワード/パターンを登録する。一致した箇所だけに色が付き、行は消えない（絞り込みとは別）。パターンは正規表現として解釈され、大文字小文字は区別しない。詳細は README の「Highlight rules」参照。",
          "items": {
            "type": "object",
            "required": [
              "pattern"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "このルールの表示名。設定を見分けるためと、警告文言に使う。省略時は highlight-<連番>。"
              },
              "pattern": {
                "type": "string",
                "description": "色を付ける箇所にマッチする正規表現（大文字小文字は区別しない）。1行の中の一致箇所はすべて色が付く。"
              },
              "color": {
                "type": "string",
                "enum": [
                  "red",
                  "orange",
                  "yellow",
                  "green",
                  "blue",
                  "purple"
                ],
                "default": "yellow",
                "description": "色。明るいテーマ・暗いテーマそれぞれで読める値が使われる。省略時は yellow。"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/esbuild.js --production",
    "watch": "node scripts/esbuild.js --watch",
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json",
    "check-types": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "lint": "eslint src scripts eslint.config.mjs",
    "test": "vscode-test",
    "check:package": "node scripts/check-package-contents.js",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/totonoe-log.vsix",
    "install:vsix": "code --install-extension dist/totonoe-log.vsix --force",
    "package:install": "npm run package && npm run install:vsix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
